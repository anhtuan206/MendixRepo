.classCheckbox{
    input[type="checkbox"] {
        content: "";
        background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABwAAAAYCAYAAADpnJ2CAAAAo0lEQVRIDWP4T2fAQGf7/g8OC5efu/1fsX7+f8n6ReTh8un/syfNxxp4WH1IkWUwR5ZPJ95Csn0GswxKY7MRqw9HLSQ2BEaDFB4CyEE2/ekfuDh+xp//l4+g5lts6gmm0mWvsWnDLnbrHBUspLsPkYOXVDa2cCAYpKRagqx+1EJ4CCAHCyVsuIFIDKxxSPfqie4VMFIIUJ2JNUipbguSgXS3EADJRnmZIWuvjAAAAABJRU5ErkJggg==');
        background-position: center;
        background-size: auto 135%;
        border-radius: 5px;
    }
    input:checked:after{
        outline:none;
        animation: none;
        content: "";
        color: black;
        border: none;
    }
    input:hover:after{
        outline:none;
        animation: none;
        content: "";
        border: none;
    }
}

.classItemGallerySel{
    background-color: #005f87;
     color: white; 
}

.mx-name-listStepItem{
    .mx-listview-empty{
        display: none;
    }
}

.ReadOnly-Class{
    cursor: not-allowed;
}

.NoEvent-Class-Button{
    color: #aaaaaa;
    border-color: #aaaaaa;
    background-color: #ffffff;
    cursor: not-allowed;
    pointer-events: none;
}

.ReadOnly-Class-Button{
    cursor: not-allowed;
   width: fit-content;
}

.NoEvent-Class-Input{
    .form-control{
        border-color: #969696;
        background-color: #f0f0f0;
        
        pointer-events: none;
    }
}

.error-IsRequired{
    .form-control{
    background-image: url(data:image/svg+xml;charset=utf-8;base64,);
    background-repeat: no-repeat;
    background-position: left top;
    background-position-x: left;
    background-size: 10px 10px;
    padding-left: 10px;
    border-color: #dc0000;
    };
}

.mx-name-WIBorder{
    .mx-groupbox {
        margin: 0px ;
        .mx-listview {
            border-bottom: 0px !important;
        }
 }
}

.WI-PartiallyCompleted{
    border-left: 10px solid #FAB80C;
    padding:0px;
}

.WI-Completed{
    border-left: 10px solid #3B9B35;
    padding:0px;
}

.WI-New{
    border-left: 10px solid #025F88;
    padding:0px;
}

.stepNotActive{
    background-color: #EDFCF5;
}

.stepComplete{
    background-color: #EDFCF5;
    //background-image: url('data:image/png;base64,');
    background-repeat: no-repeat;
    background-position: right 15px top 15px;
    background-size: 20px 20px;
}

.Textbox-DataCollector{
    width: 100%;
}

.text-dataCollector{
    padding-top: 0px;
    padding-bottom: 25px;
}

.layoutgrid-datacollector-item{
    padding-left: 0px;
}

.mx-name-listStepItem{
    .listview-row-item-grid{
        padding-left: 0px;
    }
}

.mx-name-WIConfirmBn{
    width: 50px;
    background-color: transparent;
}

.mx-name-WIAcknowledgeBn{
    width: 50px;
    background-color: transparent;
}

.mx-name-accordionWI{
    .widget-accordion-group{
        > .widget-accordion-group-header > .widget-accordion-group-header-button {
            cursor: auto;
    
            &.widget-accordion-group-header-button-clickable {
                &:hover,
                &:focus,
                &:active {
                    background-color: transparent;
    
                    > :is(h1, h2, h3, h4, h5, h6, p, span) {
                        color: black;
                    }
                }
            }
        }
        .widget-accordion-group-content{
            padding: 0px;
            //background-color: white;
            .accordionSection-Active{
                .widget-accordion-group{
                    .widget-accordion-group-header{
                        background-color: white; 
                    }
                }
            }
            .accordionSection-PartiallyCompleted{
                .widget-accordion-group{
                    .widget-accordion-group-header{
                        background-color: #FEF7CC; 
                    }
                }
            }
            .accordionSection-NotActive{
                .widget-accordion-group{
                    .widget-accordion-group-header{
                        background-color: #EBEBEB; 
                        color: #aaaaaa;
                    }
                    .widget-accordion-group-content{
                        background-color: #EBEBEB; 
                    }
                }
            }            
            .accordionSection-Complete{
                .widget-accordion-group{
                    .widget-accordion-group-header{
                        background-color: #EDFCF5;
                        //background-image: url('data:image/png;base64,');
                        background-repeat: no-repeat;
                        background-position: right 15px top 15px;
                        background-size: 20px 20px;
                        color: #aaaaaa;
                    }
                    .widget-accordion-group-content{
                        background-color: #EDFCF5;
                        //background-image: url('data:image/png;base64,');
                        background-repeat: no-repeat;
                        background-position: right 15px top 15px;
                        background-size: 20px 20px;
                    }
                }
            }
        }
    }
}

.accordionWI-PartiallyCompleted{
    .widget-accordion-group{
        .widget-accordion-group-header{
            background-color: #FEF7CC; 
        }
    }
}

.accordionWI-Completed{
    .widget-accordion-group{
        .widget-accordion-group-header{
            background-color: #EDFCF5;
            //background-image: url('data:image/png;base64,');
            background-repeat: no-repeat;
            background-position: right 15px top 15px;
            background-size: 20px 20px;
            color: #aaaaaa; 
        }
    }
}


